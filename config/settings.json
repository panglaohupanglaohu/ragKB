{
  "system": {
    "name": "AgentsGroup2026",
    "version": "1.0.0",
    "description": "Agent Management + Evolution + Chat Platform"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "llm": {
    "provider": "codebuddy",
    "model": "glm-5.1",
    "api_base_url": "https://models.sjtu.edu.cn/api/v1",
    "max_tokens": 4096,
    "temperature": 0.7,
    "thinking": {
      "type": "enabled"
    },
    "reasoning_effort": "high",
    "api_key": ""
  },
  "openclaw": {
    "enabled": true,
    "default_gateway": "http://localhost:3008",
    "protocol_version": "v1"
  },
  "tts": {
    "engine": "gpt-sovits",
    "api_url": "http://127.0.0.1:9880",
    "ref_audio_path": "",
    "prompt_text": "大家好，我是一名沉稳清晰的男性播报员。下面开始正式讨论。",
    "prompt_lang": "zh",
    "text_lang": "zh",
    "speed_factor": 1.0,
    "edge_voice": "zh-CN-YunxiNeural",
    "edge_rate": "+8%",
    "gpt_sovits_dir": ""
  },
  "sandbox": {
    "mode": "lite",
    "docker_image": "agentsgroup-sandbox:python3.11",
    "memory_limit_mb": 256,
    "cpu_limit": 0.5,
    "pids_limit": 64,
    "tmpfs_tmp_mb": 64,
    "tmpfs_run_mb": 16,
    "nofile_limit": 256,
    "nproc_limit": 64,
    "file_size_limit_kb": 512,
    "network_enabled": false
  },
  "evolution_budget_tokens": 200000,
  "auto_evolution_nightly": false,
  "auto_plaza_sustainability_topics": true,
  "auto_extract_on_consensus": true,
  "trigger_daemon_enabled": false,
  "enforce_relationship_gate": false,
  "budget": {
    "per_session_max": 200000,
    "per_agent_daily_max": 2000000,
    "per_team_daily_max": 10000000,
    "on_exceed": "halt",
    "alert_threshold": 0.8
  },
  "global_model": {
    "team_id": "build_system",
    "model_id": "codebuddy"
  }
}