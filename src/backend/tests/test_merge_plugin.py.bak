class TestMergeJob:
    """MergeJob 数据模型测试."""

    def test_create_empty_job(self):
        job = MergeJob()
        assert job.status == "pending"
        assert len(job.rules) == 0
        assert len(job.items) == 0

    def test_create_job_with_data(self):
        rule = MergeRule(name="R1")
        items = [MergeItem(content="test")]
        job = MergeJob(job_id="j1", rules=[rule], items=items)
        assert job.job_id == "j1"
        assert len(job.rules) == 1
        assert len(job.items) == 1

    def test_to_dict(self):
        rule = MergeRule(rule_id="r1")
        job = MergeJob(
            job_id="j1",
            rules=[rule],
            items=[MergeItem(content="hello")],
            status="completed",
        )
        d = job.to_dict()
        assert d["job_id"] == "j1"
        assert d["item_count"] == 1
        assert d["status"] == "completed"


# ═══════════════════════════════════════════════════
# SimilarityEngine 测试
# ═══════════════════════════════════════════════════

class TestSimilarityEngine:
    """SimilarityEngine 单元测试."""

    def setup_method(self):
        self.engine = SimilarityEngine()

    def test_exact_match(self):
        a = MergeItem(content="hello world")
        b = MergeItem(content="hello world")
        score = self.engine.pair_score(a, b, strategy=MergeStrategy.EXACT)
        assert score == 1.0

    def test_exact_mismatch(self):
        a = MergeItem(content="hello")
        b = MergeItem(content="world")
        score = self.engine.pair_score(a, b, strategy=MergeStrategy.EXACT)
        assert score == 0.0

    def test_jaccard_identical(self):
        a = MergeItem(content="the cat sat")
        b = MergeItem(content="the cat sat")
        score = self.engine.pair_score(a, b, strategy=MergeStrategy.JACCARD)
        assert score == 1.0

    def test_jaccard_partial(self):
        a = MergeItem(content="the cat sat on the mat")
        b = MergeItem(content="the cat sat on the floor")
        score = self.engine.pair_score(a, b, strategy=MergeStrategy.JACCARD)
        # 5 shared words out of 7 unique = ~0.714
        assert 0.6 <= score <= 0.8

    def test_jaccard_no_overlap(self):
        a = MergeItem(content="apple banana")
        b = MergeItem(content="carrot dog")
        score = self.engine.pair_score(a, b, strategy=MergeStrategy.JACCARD)
        assert score == 0.0

    def test_cosine_identical(self):
        a = MergeItem(content="hello world")
        b = MergeItem(content="hello world")
        score = self.engine.pair_score(a, b, strategy=MergeStrategy.COSINE)
        assert score == pytest.approx(1.0)

    def test_cosine_no_overlap(self):
        a = MergeItem(content="aaa bbb")
        b = MergeItem(content="ccc ddd")
        score = self.engine.pair_score(a, b, strategy=MergeStrategy.COSINE)
        assert score == 0.0

    def test_levenshtein_identical(self):
        a = MergeItem(content="abc")
        b = MergeItem(content="abc")
        score = self.engine.pair_score(a, b, strategy=MergeStrategy.LEVENSHTEIN)
        assert score == 1.0

    def test_levenshtein_different(self):
        a = MergeItem(content="kitten")
        b = MergeItem(content="sitting")
        score = self.engine.pair_score(a, b, strategy=MergeStrategy.LEVENSHTEIN)
        # kitten → sitting: 3 edits, max_len=7, score=1-3/7≈0.571
        assert 0.5 <= score <= 0.65

    def test_custom_strategy_direct(self):
        def my_sim(a, b):
            return 0.42

        a = MergeItem(content="x")
        b = MergeItem(content="y")
        score = self.engine.pair_score(
            a, b, strategy=MergeStrategy.CUSTOM, custom_fn=my_sim,
        )
        assert score == 0.42

    def test_custom_strategy_registered(self):
        self.engine.register_custom_strategy(
            "half", lambda a, b: 0.5,
        )
        a = MergeItem(content="x")
        b = MergeItem(content="y")
        score = self.engine.pair_score(
            a, b, strategy=MergeStrategy.CUSTOM,
            config={"custom_name": "half"},
        )
        assert score == 0.5

    def test_cluster_scores_single(self):
        items = [MergeItem(content="only one")]
        scores = self.engine.cluster_scores(items, strategy=MergeStrategy.JACCARD)
        assert scores == [1.0]

    def test_cluster_scores_multiple(self):
        items = [
            MergeItem(content="a b c"),
            MergeItem(content="a b c d"),
        ]
        scores = self.engine.cluster_scores(items, strategy=MergeStrategy.JACCARD)
        assert len(scores) == 1
        assert scores[0] == pytest.approx(0.75)

    def test_score_clamping(self):
        # Custom function returning out-of-range values should be clamped
        def extreme_sim(a, b):
            return 1.5

        a = MergeItem(content="x")
        b = MergeItem(content="y")
        score = self.engine.pair_score(
            a, b, strategy=MergeStrategy.CUSTOM, custom_fn=extreme_sim,
        )
        assert score == 1.0


# ═══════════════════════════════════════════════════
# MergeEngine 测试
# ═══════════════════════════════════════════════════

class TestMergeEngineClustering:
    """MergeEngine clustering 单元测试."""

    def setup_method(self):
        self.engine = SimilarityEngine()

    def test_single_item_cluster(self):
        items = [MergeItem(content="hello", item_id="1")]
        rule = MergeRule(strategy=MergeStrategy.JACCARD, threshold=0.5)
        clusters = _cluster_items(items, rule, self.engine)
        assert len(clusters) == 1
        assert clusters[0][0].item_id == "1"

    def test_no_similar_items(self):
        items = [
            MergeItem(content="aaa bbb ccc", item_id="1"),
            MergeItem(content="ddd eee fff", item_id="2"),
        ]
        rule = MergeRule(strategy=MergeStrategy.JACCARD, threshold=0.9)
        clusters = _cluster_items(items, rule, self.engine)
        # Low threshold? No, 0 jaccard for disjoint sets
        assert len(clusters) == 2  # each in its own cluster

    def test_similar_items_grouped(self):
        items = [
            MergeItem(content="the cat sat on mat", item_id="1"),
            MergeItem(content="the cat sat on rug", item_id="2"),
            MergeItem(content="the cat sat on floor", item_id="3"),
            MergeItem(content="a dog ran fast", item_id="4"),
        ]
        rule = MergeRule(strategy=MergeStrategy.JACCARD, threshold=0.5)
        clusters = _cluster_items(items, rule, self.engine)
        # 1,2,3 should cluster; 4 alone
        cluster_ids = [sorted(c[0].item_id for c in cluster) if len(cluster) > 1 
                       else [cluster[0].item_id] 
                       for cluster in clusters]
        # Verify: one cluster with three items, one singleton
        sizes = [len(c) for c in clusters]
        assert sorted(sizes) == [1, 3]

    def test_empty_items(self):
        clusters = _cluster_items([], MergeRule(), self.engine)
        assert clusters == []


class TestMergeEngineAsync:
    """MergeEngine 异步处理测试."""

    @pytest.mark.asyncio
    async def test_submit_and_complete(self):
        engine = MergeEngine(max_concurrency=2)
        await engine.start()

        items = [
            MergeItem(content="hello world", item_id="1"),
            MergeItem(content="hello world again", item_id="2"),
        ]
        rule = MergeRule(
            name="Test",
            strategy=MergeStrategy.JACCARD,
            threshold=0.3,
            action=MergeAction.KEEP_LONGEST,
        )
        job = MergeJob(rules=[rule], items=items)

        result = await engine.submit(job)
        await engine.stop()

        assert result.status == "completed"
        assert len(result.results) >= 1

    @pytest.mark.asyncio
    async def test_submit_fire_and_forget(self):
        engine = MergeEngine(max_concurrency=2)
        await engine.start()

        items = [MergeItem(content="test", item_id="1")]
        rule = MergeRule()
        job = MergeJob(rules=[rule], items=items)

        job_id = await engine.submit_fire_and_forget(job)
        # Wait a bit for processing
        await asyncio.sleep(0.2)
        await engine.stop()

        result = engine.get_result(job_id)
        assert result is not None
        assert result.status == "completed"

    @pytest.mark.asyncio
    async def test_multiple_rules(self):
        engine = MergeEngine(max_concurrency=2)
        await engine.start()

        items = [
            MergeItem(content="a b c", item_id="1", metadata={"score": 0.1}),
            MergeItem(content="a b c d", item_id="2", metadata={"score": 0.9}),
        ]
        rules = [
            MergeRule(rule_id="r1", name="Longest", action=MergeAction.KEEP_LONGEST, threshold=0.5),
            MergeRule(rule_id="r2", name="Best", action=MergeAction.PICK_BEST_SCORE, threshold=0.5),
        ]
        job = MergeJob(rules=rules, items=items)

        result = await engine.submit(job)
        await engine.stop()

        assert result.status == "completed"
        # Each rule produces 1 result (items clustered together)
        assert len(result.results) == 2

    @pytest.mark.asyncio
    async def test_disabled_rule_skipped(self):
        engine = MergeEngine(max_concurrency=2)
        await engine.start()

        items = [MergeItem(content="test")]
        rules = [
            MergeRule(rule_id="r1", enabled=True, threshold=0.5),
            MergeRule(rule_id="r2", enabled=False, threshold=0.5),
        ]
        job = MergeJob(rules=rules, items=items)
        result = await engine.submit(job)
        await engine.stop()

        # Only the enabled rule should produce results
        rule_ids = {r.rule_id for r in result.results}
        assert "r1" in rule_ids
        assert "r2" not in rule_ids

    @pytest.mark.asyncio
    async def test_group_key_isolation(self):
        """Items with different group_keys should never merge together."""
        engine = MergeEngine(max_concurrency=2)
        await engine.start()

        items = [
            MergeItem(content="hello world", item_id="a", group_key="g1"),
            MergeItem(content="hello world again", item_id="b", group_key="g2"),
        ]
        rule = MergeRule(strategy=MergeStrategy.JACCARD, threshold=0.3, action=MergeAction.KEEP_LONGEST)
        job = MergeJob(rules=[rule], items=items)
        result = await engine.submit(job)
        await engine.stop()

        # Should produce 2 separate results (one per group_key)
        assert len(result.results) == 2
        all_source_ids = set()
        for r in result.results:
            for it in r.source_items:
                all_source_ids.add(it.item_id)
        assert all_source_ids == {"a", "b"}

    @pytest.mark.asyncio
    async def test_engine_stats(self):
        engine = MergeEngine(max_concurrency=2)
        assert engine.stats()["running"] is False
        assert engine.stats()["total_processed"] == 0

        await engine.start()
        assert engine.stats()["running"] is True

        await engine.stop()
        assert engine.stats()["running"] is False


# ═══════════════════════════════════════════════════
# MergeChannel 测试
# ═══════════════════════════════════════════════════

class TestMergeChannel:
    """MergeChannel 单元测试 (sync event handling)."""

    def test_create_channel(self):
        channel = MergeChannel(max_concurrency=1, enable_presets=False)
        assert channel.name == "merge_plugin"
        assert channel.priority.name == "P2"
        assert channel._initialized is False

    def test_preset_rules_loaded(self):
        channel = MergeChannel(max_concurrency=1, enable_presets=True)
        assert len(channel._custom_rules) == len(PRESET_RULES)
        for rule_id in PRESET_RULES:
            assert rule_id in channel._custom_rules

    def test_rule_add_remove(self):
        channel = MergeChannel(max_concurrency=1, enable_presets=False)
        assert len(channel._custom_rules) == 0

        # Add rule
        resp = channel.process_event({
            "type": "merge_rule_add",
            "rule": {
                "rule_id": "custom-1",
                "name": "Custom Rule",
                "strategy": "cosine",
                "threshold": 0.6,
                "action": "concatenate",
            },
        })
        assert resp["ok"] is True
        assert len(channel._custom_rules) == 1
        assert channel.get_rule("custom-1") is not None

        # Remove rule
        resp = channel.process_event({
            "type": "merge_rule_remove",
            "rule_id": "custom-1",
        })
        assert resp["ok"] is True
        assert len(channel._custom_rules) == 0

    def test_rule_list(self):
        channel = MergeChannel(max_concurrency=1, enable_presets=True)
        resp = channel.process_event({"type": "merge_rule_list"})
        assert resp["ok"] is True
        assert len(resp["rules"]) == len(PRESET_RULES)

    def test_unknown_event_type(self):
        channel = MergeChannel(max_concurrency=1)
        resp = channel.process_event({"type": "nonexistent"})
        assert resp["ok"] is False
        assert "Unknown event type" in resp["error"]

    def test_stats(self):
        channel = MergeChannel(max_concurrency=1)
        stats = channel.stats()
        assert stats["name"] == "merge_plugin"
        assert "custom_rules_count" in stats

    def test_get_status(self):
        channel = MergeChannel(max_concurrency=1)
        status = channel.get_status()
        assert status["name"] == "merge_plugin"
        assert status["version"] == "1.0.0"

    def test_programmatic_rule_management(self):
        channel = MergeChannel(max_concurrency=1, enable_presets=False)
        rule = MergeRule(rule_id="prog-1", name="Programmatic")
        
        channel.add_rule(rule)
        assert channel.get_rule("prog-1") is not None
        assert len(channel.list_rules()) == 1

        assert channel.remove_rule("prog-1") is True
        assert channel.remove_rule("prog-1") is False
        assert len(channel.list_rules()) == 0

    def test_rule_remove_not_found(self):
        channel = MergeChannel(max_concurrency=1)
        resp = channel.process_event({
            "type": "merge_rule_remove",
            "rule_id": "no-such-rule",
        })
        assert resp["ok"] is False

    def test_result_get_not_found(self):
        channel = MergeChannel(max_concurrency=1)
        resp = channel.process_event({
            "type": "merge_result_get",
            "job_id": "no-such-job",
        })
        assert resp["ok"] is False


# ═══════════════════════════════════════════════════
# Merge Actions 测试
# ═══════════════════════════════════════════════════

class TestMergeActions:
    """验证所有合并动作的正确行为."""

    @pytest.mark.asyncio
    async def test_keep_longest(self):
        engine = MergeEngine(max_concurrency=1)
        await engine.start()

        items = [
            MergeItem(content="short", item_id="1"),
            MergeItem(content="the longest content here", item_id="2"),
            MergeItem(content="medium text", item_id="3"),
        ]
        rule = MergeRule(
            strategy=MergeStrategy.JACCARD,
            threshold=0.0,  # merge everything
            action=MergeAction.KEEP_LONGEST,
        )
        job = MergeJob(rules=[rule], items=items)
        result = await engine.submit(job)
        await engine.stop()

        assert result.results[0].merged_content == "the longest content here"

    @pytest.mark.asyncio
    async def test_keep_shortest(self):
        engine = MergeEngine(max_concurrency=1)
        await engine.start()

        items = [
            MergeItem(content="long long long text", item_id="1"),
            MergeItem(content="short", item_id="2"),
        ]
        rule = MergeRule(
            strategy=MergeStrategy.JACCARD,
            threshold=0.0,
            action=MergeAction.KEEP_SHORTEST,
        )
        job = MergeJob(rules=[rule], items=items)
        result = await engine.submit(job)
        await engine.stop()

        assert result.results[0].merged_content == "short"

    @pytest.mark.asyncio
    async def test_concatenate(self):
        engine = MergeEngine(max_concurrency=1)
        await engine.start()

        items = [
            MergeItem(content="First text", item_id="1"),
            MergeItem(content="Second text", item_id="2"),
        ]
        rule = MergeRule(threshold=0.0, action=MergeAction.CONCATENATE)
        job = MergeJob(rules=[rule], items=items)
        result = await engine.submit(job)
        await engine.stop()

        merged = result.results[0].merged_content
        assert "First text" in merged
        assert "Second text" in merged
        assert "---" in merged

    @pytest.mark.asyncio
    async def test_pick_first(self):
        engine = MergeEngine(max_concurrency=1)
        await engine.start()

        items = [
            MergeItem(content="first arrived", item_id="1"),
            MergeItem(content="second arrived", item_id="2"),
        ]
        rule = MergeRule(threshold=0.0, action=MergeAction.PICK_FIRST)
        job = MergeJob(rules=[rule], items=items)
        result = await engine.submit(job)
        await engine.stop()

        assert result.results[0].merged_content == "first arrived"

    @pytest.mark.asyncio
    async def test_pick_best_score(self):
        engine = MergeEngine(max_concurrency=1)
        await engine.start()

        items = [
            MergeItem(content="low", item_id="1", metadata={"score": 0.1}),
            MergeItem(content="high", item_id="2", metadata={"score": 0.99}),
            MergeItem(content="mid", item_id="3", metadata={"score": 0.5}),
        ]
        rule = MergeRule(threshold=0.0, action=MergeAction.PICK_BEST_SCORE)
        job = MergeJob(rules=[rule], items=items)
        result = await engine.submit(job)
        await engine.stop()

        assert result.results[0].merged_content == "high"
