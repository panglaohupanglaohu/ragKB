# -*- coding: utf-8 -*-
"""Similarity Merge Plugin — 单元测试.

Tests:
  - Data models (MergeItem, MergeRule, MergeResult, MergeJob)
  - SimilarityEngine (all strategies)
  - MergeEngine (clustering, async processing)
  - MergeChannel (event handling)
"""

from __future__ import annotations

import asyncio
import json

import pytest

pytestmark = pytest.mark.anyio

from agents.merge_models import (
    MergeAction,
    MergeItem,
    MergeJob,
    MergeResult,
    MergeRule,
    MergeStrategy,
)
from agents.similarity_engine import SimilarityEngine
from agents.merge_engine import MergeEngine, _cluster_items
from channels.merge_channel import MergeChannel, PRESET_RULES


# ═══════════════════════════════════════════════════
# MergeItem 测试
# ═══════════════════════════════════════════════════

class TestMergeItem:
    """MergeItem 数据模型测试."""

    def test_create_minimal(self):
        item = MergeItem(content="hello")
        assert item.content == "hello"
        assert len(item.item_id) == 8
        assert item.metadata == {}
        assert item.group_key is None

    def test_create_with_metadata(self):
        item = MergeItem(
            content="test",
            item_id="my-id",
            metadata={"score": 0.95, "source": "agent-a"},
            group_key="topic-1",
        )
        assert item.item_id == "my-id"
        assert item.metadata["score"] == 0.95
        assert item.group_key == "topic-1"

    def test_to_dict(self):
        item = MergeItem(content="abc", item_id="001")
        d = item.to_dict()
        assert d["item_id"] == "001"
        assert d["content"] == "abc"

    def test_from_dict(self):
        d = {"item_id": "002", "content": "xyz", "metadata": {"k": "v"}, "group_key": "g"}
        item = MergeItem.from_dict(d)
        assert item.item_id == "002"
        assert item.content == "xyz"
        assert item.metadata == {"k": "v"}
        assert item.group_key == "g"

    def test_from_dict_minimal(self):
        item = MergeItem.from_dict({"content": "bare minimum"})
        assert item.content == "bare minimum"
        assert len(item.item_id) == 8

    def test_json_serializable(self):
        item = MergeItem(content="test json")
        json_str = json.dumps(item.to_dict())
        restored = json.loads(json_str)
        assert restored["content"] == "test json"


# ═══════════════════════════════════════════════════
# MergeRule 测试
# ═══════════════════════════════════════════════════

class TestMergeRule:
    """MergeRule 数据模型测试."""

    def test_default_rule(self):
        rule = MergeRule()
        assert rule.strategy == MergeStrategy.JACCARD
        assert rule.threshold == 0.75
        assert rule.action == MergeAction.KEEP_LONGEST
        assert rule.enabled is True

    def test_custom_rule(self):
        rule = MergeRule(
            name="My Rule",
            strategy=MergeStrategy.COSINE,
            threshold=0.5,
            action=MergeAction.CONCATENATE,
        )
        assert rule.name == "My Rule"
        assert rule.strategy == MergeStrategy.COSINE
        assert rule.threshold == 0.5
        assert rule.action == MergeAction.CONCATENATE

    def test_to_dict(self):
        rule = MergeRule(rule_id="r1", name="Test", threshold=0.8)
        d = rule.to_dict()
        assert d["rule_id"] == "r1"
        assert d["strategy"] == "jaccard"
        assert d["threshold"] == 0.8

    def test_from_dict(self):
        d = {
            "rule_id": "r2",
            "name": "FromDict",
            "strategy": "cosine",
            "threshold": 0.6,
            "action": "pick_best_score",
            "enabled": False,
        }
        rule = MergeRule.from_dict(d)
        assert rule.rule_id == "r2"
        assert rule.strategy == MergeStrategy.COSINE
        assert rule.action == MergeAction.PICK_BEST_SCORE
        assert rule.enabled is False

    def test_roundtrip_json(self):
        rule = MergeRule(
            name="Roundtrip",
            strategy=MergeStrategy.LEVENSHTEIN,
            threshold=0.9,
            action=MergeAction.PICK_FIRST,
        )
        json_str = json.dumps(rule.to_dict())
        restored = MergeRule.from_dict(json.loads(json_str))
        assert restored.name == "Roundtrip"
        assert restored.strategy == MergeStrategy.LEVENSHTEIN


