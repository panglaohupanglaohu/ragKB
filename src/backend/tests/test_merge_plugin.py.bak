class TestMergeResult:
    """MergeResult 数据模型测试."""

    def test_create_result(self):
        items = [
            MergeItem(content="a", item_id="1"),
            MergeItem(content="b", item_id="2"),
        ]
        result = MergeResult(
            rule_id="r1",
            merged_content="merged!",
            source_items=items,
            similarity_scores=[0.85],
            cluster_avg_similarity=0.85,
            action="keep_longest",
        )
        assert result.rule_id == "r1"
        assert result.merged_content == "merged!"
        assert len(result.source_items) == 2

    def test_to_dict(self):
        items = [MergeItem(content="x", item_id="x1")]
        result = MergeResult(
            result_id="res-1",
            rule_id="r1",
            merged_content="output",
            source_items=items,
            action="concatenate",
        )
        d = result.to_dict()
        assert d["result_id"] == "res-1"
        assert d["merged_content"] == "output"
        assert d["source_count"] == 1


