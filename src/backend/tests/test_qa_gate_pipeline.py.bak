# -*- coding: utf-8 -*-
"""QA Gate Pipeline 验证测试 — 当 QA verdict=PASS 时 pipeline 不应被阻断.

覆盖场景:
  1. 门禁评估器 PASS 场景 → passed=True (集成到现有 test_gate_evaluator.py)
  2. QA 报告解析 — verdict 提取逻辑 (PASS/FAIL/BLOCKER)
  3. Pipeline 门禁决策 — gate_blocked 标志正确性
  4. PASS 不阻断 / FAIL 阻断 / BLOCKER 阻断
  5. 边界情况: 缺失 JSON、缺失 Markdown、空报告、格式变化
"""

from __future__ import annotations

import json
import os
import re
import tempfile
from pathlib import Path
from typing import Dict, List, Optional, Tuple

import pytest

from agents.review_models import GateEvaluationContext, GateLevel, GateEvaluationResult


# ═══════════════════════════════════════════════════════════════
# 提取自 api.py 的 verdict 解析逻辑（纯函数版本，方便测试）
# ═══════════════════════════════════════════════════════════════

# 从 api.py line 2845 提取的正则 (增强版: 支持全角冒号 ：
# 和 emoji ✅/❌, 以及中文"阻断")
VERDICT_PATTERN = re.compile(
    r"^[#\s]*验证结论[：:\s]+(fail|失败|blocked|阻断|pass|通过|✅|❌)(?:\s|$)",
    re.IGNORECASE,
)
BLOCKER_PATTERN = re.compile(r"blocker|阻断|🚫", re.IGNORECASE)
PASS_PATTERN = re.compile(r"pass|通过|✅", re.IGNORECASE)
FAIL_PATTERN = re.compile(r"fail|失败|❌", re.IGNORECASE)


def parse_json_verdict(json_path: str) -> Dict[str, str]:
    """从 JSON 文件解析 verdict (模拟 api.py line 2830-2838)."""
    try:
        with open(json_path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        return {"ok": False, "verdict": "", "error": "json parse error"}

    v = ""
    if isinstance(data, dict):
        for key in ("verdict", "结论", "qa_verdict", "status"):
            if key in data:
                raw = data[key]
                if isinstance(raw, dict):
                    v = str(raw.get("verdict", raw.get("result", "")))
                else:
                    v = str(raw)
                break
    return {"ok": True, "verdict": v.upper() if v else ""}


def parse_markdown_verdict(md_text: str) -> Dict[str, str]:
    """从 Markdown 文本解析 verdict (模拟 api.py line 2840-2863)."""
    verdict = ""
    blocker = False
    for line in md_text.splitlines():
        m = VERDICT_PATTERN.match(line.strip())
        if m:
            raw = m.group(1).lower()
            if raw in ("fail", "失败", "❌"):
                verdict = "FAIL"
            elif raw in ("pass", "通过", "✅"):
                verdict = "PASS"
            elif raw in ("blocked", "阻断", "🚫"):
                verdict = "BLOCKED"
        if BLOCKER_PATTERN.search(line):
            # Only treat as blocker if not in prompt echo
            if "blocker" not in line.split("##")[0]:
                blocker = True
    return {"verdict": verdict, "has_blocker": blocker}


def evaluate_qa_gate(
    test_step_status: str,
    json_verdict: Optional[str],
    md_verdict: Optional[str],
    md_has_blocker: bool = False,
) -> Tuple[bool, str]:
    """综合评估 QA 门禁 — 模拟 api.py 中 deploy step 前的 gate 检查逻辑.

    Returns:
        (gate_blocked: bool, gate_reason: str)
    """
    gate_blocked = False
    gate_reason = ""

    # 1. Test step 本身失败 (执行崩溃/超时)
    if test_step_status == "failed":
        gate_blocked = True
        gate_reason = "测试步骤执行失败 (crash/timeout)"

    # 2. JSON verdict 检查
    json_verdict_checked = False
    if json_verdict is not None:
        json_verdict_checked = True
        if json_verdict == "FAIL":
            gate_blocked = True
            gate_reason = "QA 验证结论 = FAIL (JSON verdict)"

    # 3. Markdown 报告检查 (仅在 JSON 不可用时)
    if md_verdict is not None and not json_verdict_checked:
        if md_verdict == "FAIL":
            gate_blocked = True
            gate_reason = "QA 验证结论 = FAIL (Markdown verdict)"
        elif md_verdict == "BLOCKED":
            gate_blocked = True
            gate_reason = "QA 验证结论 = BLOCKED (Markdown verdict)"

    # 4. BLOCKER 级别问题检查
    if md_has_blocker and not gate_blocked:
        gate_blocked = True
        gate_reason = "QA 报告含 BLOCKER 级别问题"

    return gate_blocked, gate_reason


# ═══════════════════════════════════════════════════════════════
# 测试 1: GateEvaluator PASS 场景全部通过
# ═══════════════════════════════════════════════════════════════

class TestGateEvaluatorPassScenarios:
    """验证所有 PASS 场景下 evaluate() 返回 passed=True."""

    def test_pass_grade_a_excellent(self):
        """A 级优秀 → passed=True."""
        ctx = GateEvaluationContext(
            entity_id="QA-PASS-A",
            compliance_score=95.0,
            test_pass_rate=100.0,
            code_quality_score=95.0,
            security_issues=0,
            documentation_level=95.0,
            performance_impact=20.0,
        )
        from agents.gate_evaluator import evaluate
        result = evaluate(ctx)
        assert result.level == GateLevel.A
        assert result.passed is True
        assert result.score >= 85.0
        assert len(result.blocked_by) == 0

    def test_pass_grade_b_good(self):
        """B 级良好 → passed=True."""
        ctx = GateEvaluationContext(
            entity_id="QA-PASS-B",
            compliance_score=78.0,
            test_pass_rate=88.0,
            code_quality_score=75.0,
            security_issues=1,
            documentation_level=70.0,
            performance_impact=5.0,
        )
        from agents.gate_evaluator import evaluate
        result = evaluate(ctx)
        assert result.level in (GateLevel.A, GateLevel.B)
        assert result.passed is True

    def test_pass_grade_c_borderline(self):
        """C 级边缘通过 → passed=True (边界值: score≈55-58)."""
        # 经过加权计算，compliance=65/test=65/code=65/security_issues=3
        # 得分约 58 → C → passed
        ctx = GateEvaluationContext(
            entity_id="QA-PASS-C",
            compliance_score=65.0,
            test_pass_rate=65.0,
            code_quality_score=65.0,
            security_issues=3,
            documentation_level=65.0,
            performance_impact=0.0,
        )
        from agents.gate_evaluator import evaluate
        result = evaluate(ctx)
        # C 级及以上即为通过
        assert result.level in (GateLevel.C, GateLevel.B, GateLevel.A), (
            f"Expected C or above, got {result.level} (score={result.score})"
        )
        assert result.passed is True, f"Score={result.score}, level={result.level}"

    def test_pass_all_levels_above_e(self):
        """A/B/C/D 级别中 A/B/C 全部 passed=True, D/E passed=False."""
        from agents.gate_evaluator import evaluate

        # 高分段 → A, passed
        ctx_high = GateEvaluationContext(entity_id="hi", compliance_score=90.0)
        r_high = evaluate(ctx_high)
        assert r_high.level == GateLevel.A
        assert r_high.passed is True

        # 中段 → B/C, passed
        ctx_mid = GateEvaluationContext(entity_id="mid", compliance_score=65.0)
        r_mid = evaluate(ctx_mid)
        assert r_mid.level in (GateLevel.B, GateLevel.C)
        assert r_mid.passed is True

        # 低段 → D/E, not passed
        ctx_low = GateEvaluationContext(entity_id="low", compliance_score=35.0)
        r_low = evaluate(ctx_low)
        assert r_low.level in (GateLevel.D, GateLevel.E)
        assert r_low.passed is False

    # ── 否决项不应被 PASS 误触发 ──

    def test_veto_still_blocks_even_with_high_scores(self):
        """即便其他维度满分，否决项仍然阻止通过."""
        ctx = GateEvaluationContext(
            entity_id="QA-VETO",
            compliance_score=100.0,
            test_pass_rate=100.0,
            code_quality_score=100.0,
            has_critical_security_issue=True,  # 否决！
        )
        from agents.gate_evaluator import evaluate
        result = evaluate(ctx)
        # 否决后 score 强制为 0
        assert result.level == GateLevel.E
        assert result.passed is False
        assert result.score == 0.0

    def test_pass_with_reasonable_defaults(self):
        """默认构造的 context (字段全0) → D/E → not passed."""
        ctx = GateEvaluationContext(entity_id="QA-DEFAULT")
        from agents.gate_evaluator import evaluate
        result = evaluate(ctx)
        assert result.level in (GateLevel.D, GateLevel.E)
        assert result.passed is False


# ═══════════════════════════════════════════════════════════════
# 测试 2: QA 报告 verdict 解析逻辑
# ═══════════════════════════════════════════════════════════════

class TestQAVerdictParsing:
    """验证从 QA 报告中提取 verdict 的解析逻辑."""

    # ── Markdown verdict 解析 ──

    def test_markdown_verdict_pass_chinese(self):
        """中文 PASS 格式: '验证结论：通过'."""
        md = "# 测试报告\n验证结论：通过\n更多内容..."
        result = parse_markdown_verdict(md)
        assert result["verdict"] == "PASS"
        assert result["has_blocker"] is False

    def test_markdown_verdict_pass_english(self):
        """英文 PASS 格式: '验证结论: pass'."""
        md = "# Test Report\n验证结论: pass\n"
        result = parse_markdown_verdict(md)
        assert result["verdict"] == "PASS"

    def test_markdown_verdict_pass_with_emoji(self):
        """带 ✅ 的 PASS 格式."""
        md = "验证结论：✅ 通过"
        result = parse_markdown_verdict(md)
        assert result["verdict"] == "PASS"

    def test_markdown_verdict_fail_chinese(self):
        """中文 FAIL 格式: '验证结论：失败'."""
        md = "# 测试报告\n验证结论：失败\n原因：xxx"
        result = parse_markdown_verdict(md)
        assert result["verdict"] == "FAIL"

    def test_markdown_verdict_fail_english(self):
        """英文 FAIL 格式."""
        md = "# Test Report\n验证结论: FAIL\n"
        result = parse_markdown_verdict(md)
        assert result["verdict"] == "FAIL"

    def test_markdown_verdict_fail_with_emoji(self):
        """带 ❌ 的 FAIL 格式."""
        md = "验证结论：❌"
        result = parse_markdown_verdict(md)
        assert result["verdict"] == "FAIL"

    def test_markdown_verdict_blocked(self):
        """阻断格式."""
        md = "# 报告\n验证结论: blocked\n原因：严重bug"
        result = parse_markdown_verdict(md)
        assert result["verdict"] == "BLOCKED"

    def test_markdown_no_verdict_line(self):
        """无验证结论行 → verdict 为空."""
        md = "# 报告\n## 测试结果\n全部通过 ✓"
        result = parse_markdown_verdict(md)
        assert result["verdict"] == ""

    def test_markdown_empty(self):
        """空报告 → 无 verdict."""
        result = parse_markdown_verdict("")
        assert result["verdict"] == ""
        assert result["has_blocker"] is False

    def test_markdown_blocker_item_in_body(self):
        """报告正文含 BLOCKER 级别问题."""
        md = "# 报告\n## 问题列表\n- [BLOCKER] 核心功能崩溃\n- [minor] 样式问题"
        result = parse_markdown_verdict(md)
        assert result["has_blocker"] is True

    def test_markdown_no_blocker_item(self):
        """报告无 BLOCKER 级别问题."""
        md = "# 报告\n## 问题列表\n- [minor] 样式\n- [info] 建议"
        result = parse_markdown_verdict(md)
        assert result["has_blocker"] is False

    def test_markdown_blocker_in_echo_not_in_body(self):
        """BLOCKER 出现在 prompt echo (## 前的说明) 不应误判."""
        # 模拟: 系统提示中包含 "如果发现 BLOCKER" 但正文无
        md = "## 系统提示\n注意检查 blocker 级别问题\n## 实际结果\n全部通过 ✅"
        result = parse_markdown_verdict(md)
        # "blocker" 在 "## 系统提示" 之前，属于 echo，不应标记
        assert result["has_blocker"] is False

    # ── JSON verdict 解析 ──

    def test_json_verdict_pass(self, tmp_path):
        """JSON verdict=PASS."""
        f = tmp_path / "summary.json"
        f.write_text(json.dumps({"verdict": "PASS", "score": 95}))
        result = parse_json_verdict(str(f))
        assert result["ok"] is True
        assert result["verdict"] == "PASS"

    def test_json_verdict_fail(self, tmp_path):
        """JSON verdict=FAIL."""
        f = tmp_path / "summary.json"
        f.write_text(json.dumps({"verdict": "FAIL", "score": 30}))
        result = parse_json_verdict(str(f))
        assert result["ok"] is True
        assert result["verdict"] == "FAIL"

    def test_json_verdict_nested(self, tmp_path):
        """JSON verdict 嵌套在对象中."""
        f = tmp_path / "summary.json"
        f.write_text(json.dumps({"verdict": {"verdict": "PASS"}}))
        result = parse_json_verdict(str(f))
        assert result["verdict"] == "PASS"

    def test_json_verdict_chinese_key(self, tmp_path):
        """JSON 使用中文 key '结论'."""
        f = tmp_path / "summary.json"
        f.write_text(json.dumps({"结论": "PASS"}))
        result = parse_json_verdict(str(f))
        assert result["verdict"] == "PASS"

    def test_json_verdict_qa_verdict_key(self, tmp_path):
        """JSON 使用 'qa_verdict' key."""
        f = tmp_path / "summary.json"
        f.write_text(json.dumps({"qa_verdict": "FAIL"}))
        result = parse_json_verdict(str(f))
        assert result["verdict"] == "FAIL"

    def test_json_missing(self):
        """JSON 文件不存在."""
        result = parse_json_verdict("/nonexistent/path.json")
        assert result["ok"] is False

    def test_json_malformed(self, tmp_path):
        """JSON 格式错误."""
        f = tmp_path / "bad.json"
        f.write_text("{not valid json")
        result = parse_json_verdict(str(f))
        assert result["ok"] is False


# ═══════════════════════════════════════════════════════════════
# 测试 3: Pipeline 门禁决策 — gate_blocked 标志
# ═══════════════════════════════════════════════════════════════

class TestPipelineGateDecision:
    """验证 gate_blocked 标志在各种场景下正确."""

    # ── PASS 不阻断 (核心需求) ──

    def test_json_pass_not_blocked(self):
        """JSON verdict=PASS → gate 不阻断."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict="PASS",
            md_verdict=None,
        )
        assert blocked is False, f"应该不阻断，但被阻断了: {reason}"
        assert reason == ""

    def test_markdown_pass_not_blocked(self):
        """Markdown verdict=PASS → gate 不阻断 (无 JSON)."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict=None,
            md_verdict="PASS",
        )
        assert blocked is False, f"Markdown PASS 不应该阻断: {reason}"

    def test_no_verdict_not_blocked_by_default(self):
        """无 verdict 报告时默认不阻断 (让 pipeline 继续)."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict=None,
            md_verdict="",
        )
        assert blocked is False, f"无 verdict 时不应阻断: {reason}"

    def test_pass_with_minor_items_not_blocked(self):
        """PASS 但有 minor 问题 → 不阻断."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict="PASS",
            md_verdict="PASS",
            md_has_blocker=False,
        )
        assert blocked is False

    def test_pass_ignores_json_when_available(self):
        """JSON PASS 可用时，正确跳过 markdown 解析."""
        # 即使 markdown 说 FAIL，JSON PASS 应该优先
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict="PASS",
            md_verdict="FAIL",
        )
        assert blocked is False, f"JSON PASS 应优先，不应阻断: {reason}"

    # ── FAIL 阻断 ──

    def test_json_fail_blocked(self):
        """JSON verdict=FAIL → gate 阻断."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict="FAIL",
            md_verdict=None,
        )
        assert blocked is True
        assert "FAIL" in reason

    def test_markdown_fail_blocked(self):
        """Markdown verdict=FAIL → gate 阻断 (无 JSON)."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict=None,
            md_verdict="FAIL",
        )
        assert blocked is True
        assert "FAIL" in reason

    def test_test_step_crash_blocked(self):
        """Test step 执行崩溃 → 阻断，不管 verdict."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="failed",  # crash
            json_verdict="PASS",  # 即使 verdict PASS
            md_verdict=None,
        )
        assert blocked is True
        assert "crash" in reason.lower() or "失败" in reason

    # ── BLOCKER 阻断 ──

    def test_blocker_item_in_body_blocked(self):
        """报告含 BLOCKER 级别问题 → 阻断."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict=None,
            md_verdict="PASS",  # 结论是 PASS
            md_has_blocker=True,  # 但有 BLOCKER 条目
        )
        assert blocked is True
        assert "BLOCKER" in reason

    # ── 边界情况 ──

    def test_json_malformed_falls_through_to_markdown(self):
        """JSON 损坏时回退到 Markdown 检查."""
        # 模拟 JSON 不可用 + Markdown 可用
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict=None,  # JSON 不可用
            md_verdict="FAIL",
        )
        assert blocked is True
        assert "FAIL" in reason

    def test_all_checks_pass_no_block(self):
        """完美场景: 测试通过 + JSON PASS → 不阻断."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict="PASS",
            md_verdict="PASS",
            md_has_blocker=False,
        )
        assert blocked is False
        assert reason == ""

    def test_empty_everything_not_blocked(self):
        """完全空白的 QA 报告 → 不阻断 (不应阻断未知状态)."""
        blocked, reason = evaluate_qa_gate(
            test_step_status="completed",
            json_verdict=None,
            md_verdict="",
            md_has_blocker=False,
        )
        assert blocked is False


# ═══════════════════════════════════════════════════════════════
# 测试 4: 端到端 Pipeline 场景模拟
# ═══════════════════════════════════════════════════════════════

class TestEndToEndPipelineSimulation:
    """模拟完整 pipeline 中 QA gate 行为."""

    def _simulate_pipeline_gate(self, qa_output: Dict) -> Dict:
        """模拟 pipeline 中 gate 检查后的结果.

        Args:
            qa_output: {status, verdict, blocker, ...}

        Returns:
            {pipeline_blocked, step, reason}
        """
        status = qa_output.get("status", "completed")
        json_verdict = qa_output.get("json_verdict")
        md_verdict = qa_output.get("md_verdict")
        md_has_blocker = qa_output.get("md_has_blocker", False)

        blocked, reason = evaluate_qa_gate(
            test_step_status=status,
            json_verdict=json_verdict,
            md_verdict=md_verdict,
            md_has_blocker=md_has_blocker,
        )

        if blocked:
            return {
                "pipeline_blocked": True,
                "step": "rewind_to_develop",
                "reason": reason,
            }
        else:
            return {
                "pipeline_blocked": False,
                "step": "proceed_to_deploy",
                "reason": "",
            }

    # ── 正常流程 ──

    def test_pipeline_full_pass(self):
        """完整 PASS 场景: develop → test(PASS) → deploy."""
        result = self._simulate_pipeline_gate({
            "status": "completed",
            "json_verdict": "PASS",
            "md_verdict": "PASS",
        })
        assert result["pipeline_blocked"] is False
        assert result["step"] == "proceed_to_deploy"

    def test_pipeline_full_fail(self):
        """完整 FAIL 场景: develop → test(FAIL) → rewind."""
        result = self._simulate_pipeline_gate({
            "status": "completed",
            "json_verdict": "FAIL",
            "md_verdict": "FAIL",
        })
        assert result["pipeline_blocked"] is True
        assert result["step"] == "rewind_to_develop"

    # ── 变体场景 ──

    def test_pipeline_pass_with_minor_warnings(self):
        """QA 通过但有一些 minor 警告 → pipeline 继续."""
        result = self._simulate_pipeline_gate({
            "status": "completed",
            "json_verdict": "PASS",
            "md_verdict": "PASS",
            "md_has_blocker": False,  # 无 BLOCKER
        })
        assert result["pipeline_blocked"] is False

    def test_pipeline_test_crash_blocks(self):
        """测试步骤崩溃 → 阻断 pipeline."""
        result = self._simulate_pipeline_gate({
            "status": "failed",  # 测试执行崩溃
            "json_verdict": None,
            "md_verdict": None,
        })
        assert result["pipeline_blocked"] is True

    # ── 回归测试: PASS 绝不应阻断 ──

    @pytest.mark.parametrize("verdict_format", [
        {"json_verdict": "PASS", "md_verdict": None},
        {"json_verdict": None, "md_verdict": "PASS"},
        {"json_verdict": "PASS", "md_verdict": "PASS"},
    ])
    def test_pass_never_blocks(self, verdict_format):
        """回归断言: 任何 PASS 格式都不应阻断 pipeline."""
        result = self._simulate_pipeline_gate({
            "status": "completed",
            **verdict_format,
        })
        assert result["pipeline_blocked"] is False, (
            f"PASS verdict should NOT block pipeline. "
            f"Got: {result}"
        )

    @pytest.mark.parametrize("verdict_format", [
        {"json_verdict": "FAIL", "md_verdict": None},
        {"json_verdict": None, "md_verdict": "FAIL"},
        {"json_verdict": "FAIL", "md_verdict": "FAIL"},
    ])
    def test_fail_always_blocks(self, verdict_format):
        """回归断言: 任何 FAIL 格式都应阻断 pipeline."""
        result = self._simulate_pipeline_gate({
            "status": "completed",
            **verdict_format,
        })
        assert result["pipeline_blocked"] is True, (
            f"FAIL verdict should block pipeline. Got: {result}"
        )


# ═══════════════════════════════════════════════════════════════
# 测试 5: 门禁评估器快速 API (quick_evaluate / evaluate_from_dict)
# ═══════════════════════════════════════════════════════════════

class TestQuickEvaluatePassScenarios:
    """确保快速评估 API 也正确处理 PASS 场景."""

    def test_quick_evaluate_pass(self):
        """quick_evaluate 在 PASS 场景返回 passed=True."""
        from agents.gate_evaluator import quick_evaluate
        result = quick_evaluate(
            entity_id="QA-QUICK",
            compliance_score=80.0,
            test_pass_rate=90.0,
            code_quality_score=85.0,
        )
        assert isinstance(result, GateEvaluationResult)
        assert result.passed is True
        assert result.score >= 55.0

    def test_quick_evaluate_veto_still_blocks(self):
        """quick_evaluate 否决项仍然阻止."""
        from agents.gate_evaluator import quick_evaluate
        result = quick_evaluate(
            entity_id="QA-QUICK-VETO",
            has_critical_security_issue=True,
            compliance_score=100.0,
        )
        assert result.passed is False
        assert result.level == GateLevel.E

    def test_evaluate_from_dict_pass(self):
        """evaluate_from_dict PASS 场景."""
        from agents.gate_evaluator import evaluate_from_dict
        result = evaluate_from_dict({
            "entity_id": "QA-DICT-PASS",
            "compliance_score": 80.0,
            "test_pass_rate": 85.0,
            "code_quality_score": 80.0,
            "security_issues": 1,
            "documentation_level": 75.0,
        })
        assert result.passed is True
        assert result.level in (GateLevel.A, GateLevel.B, GateLevel.C)

    def test_evaluate_from_dict_fail(self):
        """evaluate_from_dict 否决场景."""
        from agents.gate_evaluator import evaluate_from_dict
        result = evaluate_from_dict({
            "entity_id": "QA-DICT-FAIL",
            "has_breaking_change": True,
            "compliance_score": 90.0,
        })
        assert result.passed is False
        assert result.level == GateLevel.E
