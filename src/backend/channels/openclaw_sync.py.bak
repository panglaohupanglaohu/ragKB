# -*- coding: utf-8 -*-
"""OpenClaw 智能体同步 Channel — 基于 MarineChannel 的因果一致性同步模块.

对接 OpenClaw 中的智能体，提供:
1. gRPC 拦截器风格的流量染色与路由
2. EWMA + Lamport 时钟的因果一致性升级策略
3. 多维度监控探针集成
4. ConfigMap 热更新支持
5. 冷启动预热缓存

用法:
    >>> from channels.openclaw_sync import OpenClawSyncChannel
    >>> channel = OpenClawSyncChannel()
    >>> channel.initialize()
    >>> channel.process_event({"type": "sync_request", ...})
"""

from __future__ import annotations

import asyncio
import logging
import time
from datetime import datetime, timezone
from typing import Any, Dict, List, Optional, Tuple
from uuid import uuid4

from channels.marine_base import (
    MarineChannel, ChannelPriority, ChannelStatus,
    get_default_registry,
)
from agents.ab_testing import (
    ABTestManager, ABTestMetrics, EWMAConfig,
    LamportClock, SyncPolicy, TrafficAllocation,
    get_ab_test_manager,
)

logger = logging.getLogger(__name__)


class OpenClawSyncChannel(MarineChannel):
    """OpenClaw 智能体同步 Channel.

    提供基于 EWMA 和 Lamport 时钟的因果一致性同步策略，
    支持 A/B 测试流量染色和渐进式流量分配。

    Attributes:
        ab_manager: A/B 测试管理器实例
        _sync_requests: 同步请求计数
        _sync_success: 同步成功计数
        _sync_failures: 同步失败计数
        _total_latency: 总延迟 (用于计算平均延迟)
    """

    def __init__(
        self,
        name: str = "openclaw_sync",
        description: str = "OpenClaw 智能体因果一致性同步 Channel",
        version: str = "1.0.0",
        priority: ChannelPriority = ChannelPriority.P1,
        config: Optional[EWMAConfig] = None,
        **kwargs: Any,
    ):
        super().__init__(
            name=name,
            description=description,
            version=version,
            priority=priority,
            **kwargs,
        )
        self._ab_manager: ABTestManager = get_ab_test_manager()
        if config:
            self._ab_manager.update_config(config)

        # 统计
        self._sync_requests: int = 0
        self._sync_success: int = 0
        self._sync_failures: int = 0
        self._total_latency: float = 0.0
        self._events_processed: int = 0

        # 探针数据
        self._behavior_fingerprints: Dict[str, float] = {}
        self._anomaly_propagation_depths: List[float] = []
        self._prediction_errors: List[float] = []
        self._energy_readings: List[float] = []
        self._temperature_readings: List[float] = []
        self._policy_latencies: List[float] = []

    # ── MarineChannel 接口实现 ─────────────────────────────

    def initialize(self) -> bool:
        """初始化 Channel.

        Returns:
            True 如果初始化成功.
        """
        try:
            # 预热 EWMA 引擎
            self._ab_manager.warm_up()
            self._set_health(ChannelStatus.OK, "OpenClaw Sync Channel 就绪")
            logger.info(f"✅ {self.name} 初始化完成")
            return True
        except Exception as e:
            self._set_health(ChannelStatus.ERROR, f"初始化失败: {e}")
            logger.error(f"❌ {self.name} 初始化失败: {e}")
            return False

    def process_event(self, event: Dict[str, Any]) -> Optional[Dict[str, Any]]:
        """处理同步事件 — 核心入口.

        Args:
            event: 事件字典，支持以下字段:
                - type: 事件类型 (sync_request, metrics_update, config_update)
                - node_id: 节点 ID
                - node_type: 节点类型
                - latency_ms: 同步延迟 (毫秒)
                - dependency_depth: 因果依赖深度
                - peer_clock: 对端 Lamport 时钟 (字典)
                - headers: HTTP 头 (用于流量染色解析)

        Returns:
            处理结果字典，或 None 如果事件类型未知.
        """
        self._events_processed += 1
        event_type = event.get("type", "")

        if event_type == "sync_request":
            return self._handle_sync_request(event)
        elif event_type == "metrics_update":
            return self._handle_metrics_update(event)
        elif event_type == "config_update":
            return self._handle_config_update(event)
        elif event_type == "stain_request":
            return self._handle_stain_request(event)
        elif event_type == "advance_allocation":
            return self._handle_advance_allocation(event)
        elif event_type == "get_status":
            return self.get_status()
        else:
            logger.warning(f"未知事件类型: {event_type}")
            return None

    def get_status(self) -> Dict[str, Any]:
        """获取 Channel 完整状态.

        Returns:
            状态字典.
        """
        base_status = super().get_info()
        ab_status = self._ab_manager.get_status()

        avg_latency = (
            self._total_latency / self._sync_requests
            if self._sync_requests > 0 else 0.0
        )

        return {
            **base_status,
            "health": {
                "status": self._health.status.value,
                "message": self._health.message,
                "last_check": (
                    self._health.last_check.isoformat()
                    if self._health.last_check else ""
                ),
            },
            "ab_testing": ab_status,
            "stats": {
                "events_processed": self._events_processed,
                "sync_requests": self._sync_requests,
                "sync_success": self._sync_success,
                "sync_failures": self._sync_failures,
                "avg_latency_ms": round(avg_latency, 2),
                "success_rate": round(
                    self._sync_success / max(self._sync_requests, 1), 4
                ),
            },
            "probes": {
                "behavior_fingerprint_count": len(self._behavior_fingerprints),
                "anomaly_propagation_depth_p99": self._compute_p99(
                    self._anomaly_propagation_depths
                ),
                "prediction_error_rate_p99": self._compute_p99(
                    self._prediction_errors
                ),
                "avg_energy_increase_pct": (
                    sum(self._energy_readings) / len(self._energy_readings)
                    if self._energy_readings else 0.0
                ),
                "avg_temperature_slope": (
                    sum(self._temperature_readings) / len(self._temperature_readings)
                    if self._temperature_readings else 0.0
                ),
                "policy_latency_p99": self._compute_p99(
                    self._policy_latencies
                ),
            },
        }

    def shutdown(self) -> bool:
        """关闭 Channel.

        Returns:
            True 如果关闭成功.
        """
        self._set_health(ChannelStatus.OFF, "Channel 已关闭")
        logger.info(f"🔌 {self.name} 已关闭")
        return True

    # ── 事件处理 ──────────────────────────────────────────

    def _handle_sync_request(self, event: Dict[str, Any]) -> Dict[str, Any]:
        """处理同步请求.

        Args:
            event: 事件数据.

        Returns:
            同步决策结果.
        """
        self._sync_requests += 1
        start_time = time.time()

        node_id = event.get("node_id", "unknown")
        node_type = event.get("node_type", "")
        latency_ms = event.get("latency_ms", 0.0)
        dependency_depth = event.get("dependency_depth", 1)
        headers = event.get("headers", {})

        # 解析流量染色标签
        policy = self._ab_manager._stainer.parse_stain_header(headers)

        # 如果未染色，根据节点类型决定
        if policy == SyncPolicy.FIXED_THRESHOLD and not headers.get("x-sync-policy"):
            is_experiment = self._ab_manager._stainer.should_stain_experiment(
                node_id, node_type
            )
            policy = SyncPolicy.EWMA if is_experiment else SyncPolicy.FIXED_THRESHOLD

        # 解析对端 Lamport 时钟
        peer_clock = None
        peer_clock_data = event.get("peer_clock")
        if peer_clock_data:
            peer_clock = LamportClock.from_dict(peer_clock_data)

        # 做出同步决策
        should_sync, reason = self._ab_manager.decide_sync(
            latency_ms=latency_ms,
            policy=policy,
            peer_clock=peer_clock,
            dependency_depth=dependency_depth,
            peer_node_id=node_id,
        )

        elapsed_ms = (time.time() - start_time) * 1000

        if should_sync:
            self._sync_success += 1
        else:
            self._sync_failures += 1

        self._total_latency += latency_ms

        # 记录策略评估延迟
        self._policy_latencies.append(elapsed_ms)
        if len(self._policy_latencies) > 1000:
            self._policy_latencies = self._policy_latencies[-1000:]

        result = {
            "should_sync": should_sync,
            "reason": reason,
            "policy": policy.value,
            "evaluation_latency_ms": round(elapsed_ms, 2),
            "node_id": node_id,
            "latency_ms": latency_ms,
        }

        logger.debug(
            f"同步决策: node={node_id} policy={policy.value} "
            f"sync={should_sync} latency={latency_ms:.1f}ms "
            f"eval={elapsed_ms:.2f}ms"
        )
        return result

    def _handle_metrics_update(self, event: Dict[str, Any]) -> Dict[str, str]:
        """处理指标更新事件.

        Args:
            event: 包含指标数据的事件.

        Returns:
            确认消息.
        """
        metrics = ABTestMetrics(
            false_upgrade_rate=event.get("false_upgrade_rate", 0.0),
            resource_increase_pct=event.get("resource_increase_pct", 0.0),
            behavior_fingerprint_mutation_rate=event.get(
                "behavior_fingerprint_mutation_rate", 0.0
            ),
            anomaly_propagation_depth=event.get("anomaly_propagation_depth", 0.0),
            prediction_error_rate=event.get("prediction_error_rate", 0.0),
            energy_increase_pct=event.get("energy_increase_pct", 0.0),
            temperature_slope=event.get("temperature_slope", 0.0),
            policy_evaluation_latency_ms=event.get(
                "policy_evaluation_latency_ms", 0.0
            ),
            evolution_stagnation_rate=event.get("evolution_stagnation_rate", 0.0),
        )

        # 更新探针数据
        if metrics.behavior_fingerprint_mutation_rate > 0:
            self._behavior_fingerprints["mutation_rate"] = (
                metrics.behavior_fingerprint_mutation_rate
            )
        if metrics.anomaly_propagation_depth > 0:
            self._anomaly_propagation_depths.append(
                metrics.anomaly_propagation_depth
            )
            if len(self._anomaly_propagation_depths) > 1000:
                self._anomaly_propagation_depths = (
                    self._anomaly_propagation_depths[-1000:]
                )
        if metrics.prediction_error_rate > 0:
            self._prediction_errors.append(metrics.prediction_error_rate)
            if len(self._prediction_errors) > 1000:
                self._prediction_errors = self._prediction_errors[-1000:]
        if metrics.energy_increase_pct > 0:
            self._energy_readings.append(metrics.energy_increase_pct)
            if len(self._energy_readings) > 1000:
                self._energy_readings = self._energy_readings[-1000:]
        if metrics.temperature_slope > 0:
            self._temperature_readings.append(metrics.temperature_slope)
            if len(self._temperature_readings) > 1000:
                self._temperature_readings = self._temperature_readings[-1000:]

        # 检查是否需要回滚
        self._ab_manager.update_metrics(metrics)

        logger.info(
            f"📊 指标更新: 误升级率={metrics.false_upgrade_rate:.2%} "
            f"资源增幅={metrics.resource_increase_pct:.1f}%"
        )
        return {"status": "ok", "message": "指标已更新"}

    def _handle_config_update(self, event: Dict[str, Any]) -> Dict[str, str]:
        """处理配置热更新事件.

        Args:
            event: 包含新配置的事件.

        Returns:
            确认消息.
        """
        config_data = event.get("config", {})
        new_config = EWMAConfig.from_dict(config_data)
        self._ab_manager.update_config(new_config)
        logger.info(f"♻️ 配置热更新: {config_data}")
        return {"status": "ok", "message": "配置已更新"}

    def _handle_stain_request(self, event: Dict[str, Any]) -> Dict[str, Any]:
        """处理流量染色请求.

        Args:
            event: 包含节点信息的事件.

        Returns:
            染色结果.
        """
        node_id = event.get("node_id", "unknown")
        node_type = event.get("node_type", "")
        headers = self._ab_manager._stainer.get_stain_header(node_id, node_type)
        return {
            "status": "ok",
            "headers": headers,
            "policy": headers.get("x-sync-policy", "fixed"),
        }

    def _handle_advance_allocation(self, event: Dict[str, Any]) -> Dict[str, Any]:
        """处理流量分配推进请求.

        Args:
            event: 事件数据.

        Returns:
            推进结果.
        """
        try:
            new_allocation = self._ab_manager.advance_allocation()
            return {
                "status": "ok",
                "allocation": new_allocation.value,
            }
        except RuntimeError as e:
            return {
                "status": "error",
                "message": str(e),
            }

    # ── 工具方法 ──────────────────────────────────────────

    def _compute_p99(self, values: List[float]) -> float:
        """计算 P99 百分位值.

        Args:
            values: 数值列表.

        Returns:
            P99 值.
        """
        if not values:
            return 0.0
        sorted_vals = sorted(values)
        idx = int(len(sorted_vals) * 0.99)
        return sorted_vals[min(idx, len(sorted_vals) - 1)]

    # ── 外部调用接口 ──────────────────────────────────────

    def should_stain_experiment(self, node_id: str, node_type: str = "") -> bool:
        """判断节点是否应进入实验组.

        Args:
            node_id: 节点 ID.
            node_type: 节点类型.

        Returns:
            True 表示实验组 (EWMA), False 表示对照组 (固定阈值).
        """
        return self._ab_manager._stainer.should_stain_experiment(node_id, node_type)

    def get_stain_header(self, node_id: str, node_type: str = "") -> Dict[str, str]:
        """获取流量染色头.

        Args:
            node_id: 节点 ID.
            node_type: 节点类型.

        Returns:
            包含 x-sync-policy 的 HTTP 头.
        """
        return self._ab_manager._stainer.get_stain_header(node_id, node_type)

    def record_false_upgrade(self) -> None:
        """记录一次误升级."""
        self._ab_manager._experiment_decider.record_false_upgrade()

    def get_ab_manager(self) -> ABTestManager:
        """获取 A/B 测试管理器引用.

        Returns:
            ABTestManager 实例.
        """
        return self._ab_manager


# ══════════════════════════════════════════════════════════════════
# 便捷函数
# ══════════════════════════════════════════════════════════════════


def register_channel(config: Optional[EWMAConfig] = None) -> OpenClawSyncChannel:
    """创建并注册 OpenClawSyncChannel 到全局注册表.

    Args:
        config: EWMA 策略配置 (可选).

    Returns:
        已注册的 Channel 实例.
    """
    registry = get_default_registry()
    channel = OpenClawSyncChannel(config=config)
    registry.register(channel)
    channel.initialize()
    logger.info("✅ OpenClawSyncChannel 已注册到全局注册表")
    return channel


def get_channel() -> Optional[OpenClawSyncChannel]:
    """从全局注册表获取 OpenClawSyncChannel.

    Returns:
        Channel 实例，如果未注册则返回 None.
    """
    registry = get_default_registry()
    return registry.get("openclaw_sync")  # type: ignore
